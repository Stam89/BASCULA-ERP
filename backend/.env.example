PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bascula_erp
JWT_SECRET=cambiar_esta_clave

# Cada instalación/empresa debe usar un NEGOCIO_ID diferente en Firebase. Así
# los tickets de una empresa nunca se importan en otra. FIREBASE_KEY apunta al
# archivo de credenciales de esa instalación.
# NEGOCIO_ID=identificador-unico-de-la-empresa
# FIREBASE_KEY=C:\ruta\segura\firebase-key.json
# FIREBASE_COLLECTION=tickets
# FIREBASE_WAITING_COLLECTION=ticketsEnEspera

# En una instalación nueva puede fijarse la clave inicial del administrador.
# Si se omite, el seed genera una clave aleatoria y la muestra una sola vez.
# COMPANY_NAME="PILADORA NUEVA"
# COMPANY_CODE=PILADORA-NUEVA
# FIELD_OPERATION_NAME="Transporte y Cosechadora"
# COMPANY_SUBTITLE="Piladora de Arroz"
# COMPANY_RUC=
# COMPANY_PHONE=
# COMPANY_ADDRESS=
# COMPANY_RECEIPT_FOOTER=
# SEED_ADMIN_NAME=Administrador
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=una-clave-larga-y-unica
# COMPANY_REPLACE_MATRIZ=false

# Opcional: clave compartida para que SOLO la app de la bascula pueda mandar
# tickets a /tickets/sync (la app debe enviar el header X-Device-Key con este
# mismo valor). Sin definir, /sync queda abierto como hasta ahora.
# DEVICE_SYNC_KEY=pon-aqui-una-clave-larga
