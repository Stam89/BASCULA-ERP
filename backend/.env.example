PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bascula_erp
JWT_SECRET=cambiar_esta_clave

# production protege los datos reales. test permite usar "Borrar datos de prueba"
# en una base de ensayo antes de entregar el sistema.
APP_MODE=production
# ALLOW_PRODUCTION_RESET=true solo debe usarse temporalmente por mantenimiento.
# ALLOW_PRODUCTION_RESET=false

# Cada instalación/empresa debe usar un NEGOCIO_ID diferente en Firebase. Así
# los tickets de una empresa nunca se importan en otra. FIREBASE_KEY apunta al
# archivo de credenciales de esa instalación.
# NEGOCIO_ID=identificador-unico-de-la-empresa
# Opcional: negocios antiguos separados por coma para recuperar historial tras
# formateos o recreaciones de la app. Se importan sin pisar los tickets actuales.
# FIREBASE_EXTRA_NEGOCIO_IDS=id-antiguo-1,id-antiguo-2
# FIREBASE_KEY=C:\ruta\segura\firebase-key.json
# FIREBASE_COLLECTION=tickets
# FIREBASE_WAITING_COLLECTION=ticketsEnEspera

# En una instalación nueva puede fijarse la clave inicial del administrador.
# Si se omite, el seed genera una clave aleatoria y la muestra una sola vez.
# COMPANY_NAME="PILADORA NUEVA"
# COMPANY_CODE=PILADORA-NUEVA
# FIELD_OPERATION_NAME="Transporte y Cosechadora"
# COMPANY_SUBTITLE="Piladora de Arroz"
# COMPANY_RUC=
# COMPANY_PHONE=
# COMPANY_ADDRESS=
# COMPANY_RECEIPT_FOOTER=
# SEED_ADMIN_NAME=Administrador
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=una-clave-larga-y-unica
# COMPANY_REPLACE_MATRIZ=false

# Recuperacion de clave por correo («¿Olvidaste tu clave?» en el inicio de sesion).
# Sin estas dos lineas la opcion queda desactivada (un administrador puede seguir
# restableciendo claves desde Configuracion → Control de Usuarios).
# Con Gmail: SMTP_USER es la cuenta que ENVIA los correos y SMTP_PASS una
# «contrasena de aplicacion» (Cuenta de Google → Seguridad → Verificacion en 2 pasos
# → Contrasenas de aplicaciones), NO la clave normal de Gmail.
# SMTP_USER=cuenta.del.sistema@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="Bascula ERP" <cuenta.del.sistema@gmail.com>

# Opcional: clave compartida para que SOLO la app de la bascula pueda mandar
# tickets a /tickets/sync (la app debe enviar el header X-Device-Key con este
# mismo valor). Sin definir, /sync queda abierto como hasta ahora.
# DEVICE_SYNC_KEY=pon-aqui-una-clave-larga
